<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.smhrd.web.mapper.MainMapper2">

<select id="selectTotalLogCount" parameterType="int" resultType="int">
    SELECT COUNT(*)
    FROM tb_log l
    JOIN tb_car c ON l.car_number = c.car_number
    WHERE c.driver_idx = #{driverIdx}
</select>
	
</mapper>