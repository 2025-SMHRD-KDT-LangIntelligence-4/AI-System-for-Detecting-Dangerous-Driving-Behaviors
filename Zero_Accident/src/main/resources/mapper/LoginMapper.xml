<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.smhrd.web.mapper.LoginMapper">

<select id="findById" parameterType="string" resultType="com.smhrd.web.entity.Admin">
    SELECT admin_id, admin_pwd, admin_name, admin_contact
    FROM tb_admin
    WHERE admin_id = #{adminId}
</select>

	
</mapper>