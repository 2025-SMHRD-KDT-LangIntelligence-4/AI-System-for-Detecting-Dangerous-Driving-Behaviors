<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  

<mapper namespace="com.smhrd.web.mapper.Mapper유선">
	<!-- 운전자 상세페이지 -->
    <select id="driverDetailLog" resultType="com.smhrd.web.dto.DriverDetail">
    SELECT
        log_idx,
        event_level,
        event_type,
        event_video,
        created_at,
        display_addr
    FROM tb_log
    WHERE log_idx = #{logIdx}
    </select>
    

    
    
</mapper>